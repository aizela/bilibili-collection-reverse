{
  "manifest_version": 3,
  "name": "B站合集反转",
  "version": "1.2.1",
  "description": "独立开关反转 B站合集的小节顺序和小节内视频顺序，同步原生自动连播。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "B站合集反转",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["core.js", "page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bilibili.com/video/*"],
      "js": ["session-store.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
